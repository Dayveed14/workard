# Leave EMPTY — in development Vite forwards /api to localhost:5000 (vite.config.js),
# and on Vercel vercel.json forwards /api to Render. Only set it if the API is on its own
# domain (e.g. https://api.workard.com). Never set it to the onrender.com address:
# browsers then treat the login cookie as third-party and iPhones/Safari block it.
VITE_API_URL=

# Public site URL used for canonical links, sitemap and Open Graph
VITE_SITE_URL=https://workard.com
